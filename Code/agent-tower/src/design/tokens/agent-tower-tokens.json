      "lineStrong": { "$type": "color", "$value": "rgba(177, 211, 224, 0.27)" }
    },
    "semantic": {
      "info": { "$type": "color", "$value": "#54B7D4" },
      "healthy": { "$type": "color", "$value": "#7CC89D" },
