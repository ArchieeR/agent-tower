      "dataCentre": { "$type": "color", "$value": "#A98BD4" },
      "externalCounsel": { "$type": "color", "$value": "#A9BAC2" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
