{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tower.local/schemas/agent-tower-envelope.v1.schema.json",
  "title": "Agent Tower Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "observedAt", "revision", "contentHash", "sourceRevisions", "freshness", "data", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceRevisions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "freshness": { "enum": ["live", "degraded", "stale"] },
    "data": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        }
      }
    }
  }
}
